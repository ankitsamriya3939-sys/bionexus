# BioNexus Studio Environment Configuration
# Custom Domain & API Configuration

VITE_PUBLIC_APP_URL=https://bionexusstudio.ai
VITE_API_BASE_URL=https://api.bionexusstudio.ai
VITE_AUTH_CALLBACK_URL=https://bionexusstudio.ai/auth/callback

# Optional Cloud Database & Auth Keys (Supabase / Firebase)
# VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# NCBI Entrez E-Utilities API Key (unlocks 10 req/s vs 3 req/s limit)
NCBI_API_KEY=your_ncbi_api_key_here
VITE_NCBI_API_KEY=your_ncbi_api_key_here
